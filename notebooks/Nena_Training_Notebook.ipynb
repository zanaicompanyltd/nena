   "source": [
    "# 🤟 Nena — TSL/KSL Sign Language to Swahili\n",
    "## CLIP Few-Shot Training Notebook\n",
    "\n",
    "**What this notebook does:**\n",
    "1. Installs all required libraries\n",
    "2. Downloads yt-dlp to grab sign language videos from YouTube\n",
    "3. Cuts videos into individual sign clips\n",
    "4. Extracts CLIP visual embeddings from each clip\n",
    "5. Builds a few-shot classifier (no large dataset needed)\n",
    "6. Runs a Flask API server your Flutter app can call\n",
    "7. Uses ngrok to expose the server to the internet\n",
    "\n",
    "**Runtime:** Go to Runtime → Change Runtime Type → Select **T4 GPU**"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## CELL 1 — Install Libraries"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Install all required packages\n",
    "!pip install -q torch torchvision transformers open_clip_torch\n",
    "!pip install -q yt-dlp opencv-python-headless flask flask-ngrok pyngrok\n",
    "!pip install -q scikit-learn numpy pillow\n",
    "\n",
    "print('✅ All libraries installed successfully!')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## CELL 2 — Download Sign Language Videos from YouTube"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import os\n",
    "import subprocess\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "# EDIT THIS DICTIONARY:\n",
    "# Key   = The Swahili word your sign means\n",
    "# Value = YouTube URL of a video showing that sign\n",
    "#\n",
    "# HOW TO FIND GOOD VIDEOS:\n",
    "# Search YouTube for: \"Tanzanian Sign Language Habari\" or\n",
    "# \"KSL sign language tutorial Asante\" or\n",
    "# \"lugha ya ishara habari\" (Swahili search)\n",
    "# Copy the full URL from your browser and paste it below.\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "SIGN_VIDEOS = {\n",
    "    'Habari':  'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # Hello / How are you\n",
    "    'Asante':  'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # Thank you\n",
    "    'Msaada':  'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # Help\n",
    "    'Ndiyo':   'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # Yes\n",
    "    'Hapana':  'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # No\n",
    "    'Maji':    'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # Water\n",
    "    'Chakula': 'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # Food\n",
    "    'Daktari': 'https://www.youtube.com/watch?v=PASTE_URL_HERE',  # Doctor\n",
    "}\n",
    "\n",
    "# Create download folders\n",
    "RAW_DIR = '/content/raw_videos'\n",
    "os.makedirs(RAW_DIR, exist_ok=True)\n",
    "\n",
    "for sign_word, url in SIGN_VIDEOS.items():\n",
    "    if 'PASTE_URL_HERE' in url:\n",
    "        print(f'⚠️  Skipping {sign_word} — no URL provided yet')\n",
    "        continue\n",
    "    \n",
    "    out_path = f'{RAW_DIR}/{sign_word}.mp4'\n",
    "    print(f'⬇️  Downloading: {sign_word}...')\n",
    "    \n",
    "    result = subprocess.run([\n",
    "        'yt-dlp',\n",
    "        '-f', 'mp4',           # Force MP4 format\n",
    "        '--max-filesize', '50m',  # Skip videos larger than 50MB\n",
    "        '-o', out_path,\n",
    "        url\n",
    "    ], capture_output=True, text=True)\n",
    "    \n",
    "    if os.path.exists(out_path):\n",
    "        print(f'   ✅ Saved: {out_path}')\n",
    "    else:\n",
    "        print(f'   ❌ Failed: {result.stderr[:200]}')\n",
    "\n",
    "print('\\n📂 Downloaded videos:')\n",
    "!ls -lh /content/raw_videos/"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## CELL 3 — Cut Videos into Individual Sign Clips (Frames)"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import cv2\n",
    "import os\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "\n",
    "DATASET_DIR = '/content/dataset'\n",
    "FRAMES_PER_SIGN = 16   # Extract 16 evenly spaced frames per video clip\n",
    "IMG_SIZE = 224          # CLIP expects 224×224 images\n",
    "\n",
    "def extract_frames_from_video(video_path, output_folder, n_frames=16):\n",
    "    \"\"\"Extract N evenly spaced frames from a video file.\"\"\"\n",
    "    os.makedirs(output_folder, exist_ok=True)\n",
    "    \n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "    \n",
    "    if total_frames == 0:\n",
    "        print(f'   ⚠️  Could not read: {video_path}')\n",
    "        return 0\n",
    "    \n",
    "    # Pick N evenly spaced frame indices\n",
    "    indices = np.linspace(0, total_frames - 1, n_frames, dtype=int)\n",
    "    saved = 0\n",
    "    \n",
    "    for i, frame_idx in enumerate(indices):\n",
    "        cap.set(cv2.CAP_PROP_POS_FRAMES, frame_idx)\n",
    "        ret, frame = cap.read()\n",
    "        \n",
    "        if not ret:\n",
    "            continue\n",
    "        \n",
    "        # Resize to 224×224 for CLIP\n",
    "        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n",
    "        img = Image.fromarray(frame_rgb).resize((IMG_SIZE, IMG_SIZE))\n",
    "        img.save(f'{output_folder}/frame_{i:03d}.jpg', quality=90)\n",
    "        saved += 1\n",
    "    \n",
    "    cap.release()\n",
    "    return saved\n",
    "\n",
    "# Process all downloaded videos\n",
    "print('✂️  Cutting videos into frames...\\n')\n",
    "total_frames_saved = 0\n",
    "\n",
    "for video_file in os.listdir(RAW_DIR):\n",
    "    if not video_file.endswith('.mp4'):\n",
    "        continue\n",
    "    \n",
    "    sign_word = video_file.replace('.mp4', '')\n",
    "    video_path = f'{RAW_DIR}/{video_file}'\n",
    "    output_folder = f'{DATASET_DIR}/{sign_word}'\n",
    "    \n",
    "    n_saved = extract_frames_from_video(video_path, output_folder, FRAMES_PER_SIGN)\n",
    "    total_frames_saved += n_saved\n",
    "    print(f'   ✅ {sign_word}: {n_saved} frames saved → {output_folder}')\n",
    "\n",
    "print(f'\\n🎞️  Total frames extracted: {total_frames_saved}')\n",
    "print('📂 Dataset structure:')\n",
    "!find /content/dataset -type d"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## CELL 4 — Load CLIP Model & Extract Embeddings"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import open_clip\n",
    "import torch\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "import os\n",
    "import pickle\n",
    "\n",
    "# ── Load pre-trained CLIP model ──────────────────────────────\n",
    "# ViT-B/32 is fast and works great for few-shot on modest hardware\n",
    "print('🔄 Loading CLIP model (ViT-B/32)...')\n",
    "\n",
    "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'   Using device: {device}')\n",
    "\n",
    "model, _, preprocess = open_clip.create_model_and_transforms(\n",
    "    'ViT-B-32',\n",
    "    pretrained='openai'\n",
    ")\n",
    "model = model.to(device)\n",
    "model.eval()\n",
    "print('✅ CLIP model loaded!')\n",
    "\n",
    "# ── Extract embeddings from all frames ───────────────────────\n",
    "print('\\n🧠 Extracting visual embeddings...')\n",
    "\n",
    "# This dictionary maps: sign_word → list of embedding vectors\n",
    "embeddings_db = {}   # { 'Habari': [array, array, ...], 'Asante': [...] }\n",
    "\n",
    "DATASET_DIR = '/content/dataset'\n",
    "\n",
    "for sign_word in sorted(os.listdir(DATASET_DIR)):\n",
    "    sign_dir = f'{DATASET_DIR}/{sign_word}'\n",
    "    if not os.path.isdir(sign_dir):\n",
    "        continue\n",
    "    \n",
    "    frame_files = sorted([\n",
    "        f for f in os.listdir(sign_dir) if f.endswith('.jpg')\n",
    "    ])\n",
    "    \n",
    "    if not frame_files:\n",
    "        print(f'   ⚠️  No frames found for {sign_word}')\n",
    "        continue\n",
    "    \n",
    "    sign_embeddings = []\n",
    "    \n",
    "    for frame_file in frame_files:\n",
    "        frame_path = f'{sign_dir}/{frame_file}'\n",
    "        \n",
    "        # Load and preprocess image for CLIP\n",
    "        img = Image.open(frame_path).convert('RGB')\n",
    "        tensor = preprocess(img).unsqueeze(0).to(device)\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            embedding = model.encode_image(tensor)\n",
    "            # L2-normalize the vector (required for cosine similarity)\n",
    "            embedding = embedding / embedding.norm(dim=-1, keepdim=True)\n",
    "        \n",
    "        sign_embeddings.append(embedding.cpu().numpy()[0])\n",
    "    \n",
    "    # Average all frame embeddings into one prototype vector per sign\n",
    "    # This is the \"anchor point\" in the shared embedding space\n",
    "    prototype = np.mean(sign_embeddings, axis=0)\n",
    "    prototype = prototype / np.linalg.norm(prototype)  # Re-normalize\n",
    "    embeddings_db[sign_word] = prototype\n",
    "    \n",
    "    print(f'   ✅ {sign_word}: {len(frame_files)} frames → 1 prototype vector')\n",
    "\n",
    "print(f'\\n📊 Embeddings database built: {len(embeddings_db)} signs')\n",
    "print('Signs in model:', list(embeddings_db.keys()))\n",
    "\n",
    "# Save to disk so the Flask server can load it instantly\n",
    "with open('/content/embeddings_db.pkl', 'wb') as f:\n",
    "    pickle.dump(embeddings_db, f)\n",
    "\n",
    "print('\\n💾 Saved: /content/embeddings_db.pkl')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## CELL 5 — Test the Classifier (Before Running the Server)"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np\n",
    "import pickle\n",
    "from PIL import Image\n",
    "import torch\n",
    "\n",
    "def predict_sign(image: Image.Image, embeddings_db: dict, model, preprocess, device, threshold=0.25):\n",
    "    \"\"\"\n",
    "    Given a PIL image, find the closest sign in our embeddings database.\n",
    "    Returns (predicted_word, confidence_score) or (None, 0) if below threshold.\n",
    "    \"\"\"\n",
    "    # Encode the input image with CLIP\n",
    "    tensor = preprocess(image).unsqueeze(0).to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        query_embedding = model.encode_image(tensor)\n",
    "        query_embedding = query_embedding / query_embedding.norm(dim=-1, keepdim=True)\n",
    "        query_vec = query_embedding.cpu().numpy()[0]\n",
    "    \n",
    "    # Compare against every prototype using cosine similarity\n",
    "    best_word = None\n",
    "    best_score = -1.0\n",
    "    \n",
    "    for word, prototype in embeddings_db.items():\n",
    "        # Cosine similarity = dot product of normalized vectors\n",
    "        score = float(np.dot(query_vec, prototype))\n",
    "        if score > best_score:\n",
    "            best_score = score\n",
    "            best_word = word\n",
    "    \n",
    "    # Only return a prediction if confidence is above threshold\n",
    "    if best_score >= threshold:\n",
    "        return best_word, round(best_score, 3)\n",
    "    else:\n",
    "        return None, round(best_score, 3)\n",
    "\n",
    "# ── Quick self-test: predict using one of our own training frames ──\n",
    "print('🧪 Running self-test on training frames...\\n')\n",
    "\n",
    "for sign_word in list(embeddings_db.keys())[:3]:  # Test first 3 signs\n",
    "    test_frame_path = f'/content/dataset/{sign_word}/frame_000.jpg'\n",
    "    \n",
    "    if not os.path.exists(test_frame_path):\n",
    "        continue\n",
    "    \n",
    "    img = Image.open(test_frame_path).convert('RGB')\n",
    "    predicted, confidence = predict_sign(img, embeddings_db, model, preprocess, device)\n",
    "    \n",
    "    status = '✅' if predicted == sign_word else '❌'\n",
    "    print(f'{status} True: {sign_word:10s} → Predicted: {predicted:10s} (confidence: {confidence})')\n",
    "\n",
    "print('\\n✅ Classifier is working!')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## CELL 6 — TTS Router (Voice Profile Logic)"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ─────────────────────────────────────────────────────────────\n",
    "# This is the Python equivalent of your Flutter TTS router.\n",
    "# In the full app, the TTS happens ON THE PHONE (in Flutter).\n",
    "# This cell just demonstrates the routing logic.\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "def route_to_swahili_voice(predicted_text: str, user_voice_setting: str) -> dict:\n",
    "    \"\"\"\n",
    "    Section 3.3 — Application Profile Configuration & Voice Routing.\n",
    "    \n",
    "    Swahili has no gendered pronouns (Yeye = he AND she).\n",
    "    So we decouple gender from the text completely.\n",
    "    The user's chosen profile decides the voice.\n",
    "    \"\"\"\n",
    "    print(f\"📝 Sign recognized: '{predicted_text}'\")\n",
    "    \n",
    "    # Profile Mode Alpha — Acoustic Masculine\n",
    "    if user_voice_setting == 'Male':\n",
    "        voice_id = 'sw-TZ-Standard-B'   # Google Cloud TTS male Swahili\n",
    "        pitch = -4.0                     # Lower pitch = masculine resonance\n",
    "        print(f\"🔵 Profile Mode Alpha (Male): using {voice_id}\")\n",
    "    \n",
    "    # Profile Mode Beta — Acoustic Feminine  \n",
    "    else:\n",
    "        voice_id = 'sw-TZ-Standard-A'   # Google Cloud TTS female Swahili\n",
    "        pitch = 2.0                      # Higher pitch = feminine tone\n",
    "        print(f\"🔴 Profile Mode Beta (Female): using {voice_id}\")\n",
    "    \n",
    "    result = {\n",
    "        'text': predicted_text,\n",
    "        'language': 'sw-TZ',\n",
    "        'voice_id': voice_id,\n",
    "        'pitch': pitch\n",
    "    }\n",
    "    print(f\"🔊 Would speak: {result}\\n\")\n",
    "    return result\n",
    "\n",
    "# ── Demo ─────────────────────────────────────────────────────\n",
    "print('=' * 50)\n",
    "route_to_swahili_voice('Habari gani', 'Female')\n",
    "print('=' * 50)\n",
    "route_to_swahili_voice('Asante sana', 'Male')\n",
    "print('=' * 50)"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## CELL 7 — Start Flask API Server + ngrok Tunnel"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ─────────────────────────────────────────────────────────────\n",
    "# BEFORE RUNNING: Get a free ngrok token at https://ngrok.com\n",
    "# Sign up → Dashboard → Your Authtoken → Copy it below\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "NGROK_TOKEN = 'PASTE_YOUR_NGROK_TOKEN_HERE'\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "from flask import Flask, request, jsonify\n",
    "from pyngrok import ngrok, conf\n",
    "import base64\n",
    "import io\n",
    "import threading\n",
    "\n",
    "# Set ngrok auth token\n",
    "conf.get_default().auth_token = NGROK_TOKEN\n",
    "\n",
    "app = Flask(__name__)\n",
    "\n",
    "@app.route('/health', methods=['GET'])\n",
    "def health():\n",
    "    \"\"\"Health check — Flutter app calls this to verify server is alive.\"\"\"\n",
    "    return jsonify({'status': 'ok', 'signs': list(embeddings_db.keys())})\n",
    "\n",
    "@app.route('/predict', methods=['POST'])\n",
    "def predict():\n",
    "    \"\"\"\n",
    "    Main prediction endpoint.\n",
    "    Flutter sends: { \"frame\": \"<base64 JPEG string>\" }\n",
    "    Server returns: { \"prediction\": \"Habari\", \"confidence\": 0.82 }\n",
    "    \"\"\"\n",
    "    try:\n",
    "        data = request.get_json()\n",
    "        \n",
    "        if not data or 'frame' not in data:\n",
    "            return jsonify({'error': 'No frame provided'}), 400\n",
    "        \n",
    "        # Decode base64 JPEG from Flutter\n",
    "        img_bytes = base64.b64decode(data['frame'])\n",
    "        img = Image.open(io.BytesIO(img_bytes)).convert('RGB')\n",
    "        \n",
    "        # Run CLIP few-shot prediction\n",
    "        predicted_word, confidence = predict_sign(\n",
    "            img, embeddings_db, model, preprocess, device\n",
    "        )\n",
    "        \n",
    "        if predicted_word:\n",
    "            return jsonify({\n",
    "                'prediction': predicted_word,\n",
    "                'confidence': confidence\n",
    "            })\n",
    "        else:\n",
    "            return jsonify({\n",
    "                'prediction': None,\n",
    "                'confidence': confidence,\n",
    "                'message': 'Sign not recognized — confidence too low'\n",
    "            })\n",
    "    \n",
    "    except Exception as e:\n",
    "        return jsonify({'error': str(e)}), 500\n",
    "\n",
    "@app.route('/signs', methods=['GET'])\n",
    "def list_signs():\n",
    "    \"\"\"Returns the list of all signs the model knows.\"\"\"\n",
    "    return jsonify({'signs': list(embeddings_db.keys()), 'count': len(embeddings_db)})\n",
    "\n",
    "# Start Flask in a background thread\n",
    "def run_flask():\n",
    "    app.run(port=5000, debug=False, use_reloader=False)\n",
    "\n",
    "thread = threading.Thread(target=run_flask, daemon=True)\n",
    "thread.start()\n",
    "\n",
    "# Open ngrok tunnel so your phone can reach Colab\n",
    "public_url = ngrok.connect(5000).public_url\n",
    "\n",
    "print('\\n' + '='*60)\n",
    "print('🚀 SERVER IS LIVE!')\n",
    "print('='*60)\n",
    "print(f'\\n📱 COPY THIS URL INTO YOUR FLUTTER APP:')\n",
    "print(f'\\n   {public_url}')\n",
    "print(f'\\n   Open: lib/services/ai_backend_service.dart')\n",
    "print(f'   Change _baseUrl to: {public_url!r}')\n",
    "print('\\n' + '='*60)\n",
    "print(f'Test it now in browser: {public_url}/health')\n",
    "print('='*60)"
   ],
   "execution_count": null,
   "outputs": []
  },
